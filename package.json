{
  "name": "tp-08-salas-http-mongodb",
  "version": "1.0.0",
  "description": "Aplicación web refactorizada para consultar y reservar salas de estudio",
  "main": "src/index.js",
  "scripts": {
    "start": "node --watch src/index.js",
    "start:local": "node --env-file=.env src/index.js",
    "listar": "node --env-file=.env scripts/listar-reservas.js",
    "validar": "node --env-file=.env scripts/validar-reservas.js",
    "crear": "node --env-file=.env scripts/crear-reservas.js",
    "comprobardb": "node --env-file=.env scripts/comprobar-conexion.js",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "lint": "eslint src scripts",
    "check": "node --check src/index.js && node --check src/archivos.js && npm run format:check && npm run lint",
    "comprobar": "node --check src/modelos/reservas.js",
    "comprobarServicio": "node --check src/servicios/reservas-mongo.js",
    "validarReserva": "node scripts/validar-reservas.js"
  },
  "keywords": [],
  "author": "Santiago Orellana",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^18.0.9",
    "ejs": "^3.1.10",
    "express": "^5.3.0",
    "express-ejs-layouts": "^2.5.1",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  }
}
